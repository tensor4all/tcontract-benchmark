{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tensor4all.example/schemas/benchmark-run.schema.json",
  "title": "Benchmark Run Metadata",
  "type": "object",
  "required": [
    "schema_version",
    "target_profile",
    "suite_id",
    "suite_file",
    "timestamp",
    "tprims",
    "host",
    "threads",
    "timing_policy",
    "harness",
    "command"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "target_profile": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "suite_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9/_.-]*$"
    },
    "suite_file": {
      "type": "string",
      "minLength": 1
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "command": {
      "type": "string",
      "minLength": 1
    },
    "tprims": {
      "type": "object",
      "required": [
        "url",
        "commit",
        "dirty",
        "features"
      ],
      "additionalProperties": false,
      "properties": {
        "url": {
          "type": "string",
          "pattern": "^https?://",
          "minLength": 1
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{7,40}$"
        },
        "dirty": {
          "type": "boolean"
        },
        "features": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "measured_path": {
          "type": [
            "string",
            "null"
          ],
          "description": "Where the checkout happened to live on the measuring host. Informational only: a committed manifest must validate in any checkout, so nothing resolves against this."
        },
        "version": {
          "type": [
            "string",
            "null"
          ],
          "description": "Release version of the measured revision, when the measured project has one. tcontract-rs is unpublished, so it records null; a versioned project records both this and the commit."
        }
      }
    },
    "harness": {
      "type": "object",
      "required": [
        "commit",
        "dirty"
      ],
      "additionalProperties": false,
      "properties": {
        "commit": {
          "type": "string",
          "minLength": 1
        },
        "dirty": {
          "type": [
            "boolean",
            "null"
          ]
        }
      }
    },
    "host": {
      "type": "object",
      "required": [
        "hostname",
        "cpu",
        "logical_cpus"
      ],
      "additionalProperties": false,
      "properties": {
        "hostname": {
          "type": "string"
        },
        "cpu": {
          "type": "string"
        },
        "os": {
          "type": [
            "string",
            "null"
          ]
        },
        "arch": {
          "type": [
            "string",
            "null"
          ]
        },
        "logical_cpus": {
          "type": "integer",
          "minimum": 1
        },
        "l3": {
          "type": [
            "string",
            "null"
          ]
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        },
        "l3_domains": {
          "type": [
            "string",
            "null"
          ],
          "description": "Per-domain L3 description from the hardware profile. On a host whose cores share one L3 this repeats `l3`; on a heterogeneous host (different L3 sizes per core group) it is the fact that decides whether a thread set spans one domain or two."
        }
      }
    },
    "threads": {
      "type": "object",
      "required": [
        "counts",
        "cpu_sets"
      ],
      "additionalProperties": false,
      "properties": {
        "counts": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "minItems": 1
        },
        "cpu_sets": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "env": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "timing_policy": {
      "type": "object",
      "required": [
        "version",
        "minimum_untimed_priming_ms",
        "statistic",
        "repetitions"
      ],
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": 1
        },
        "minimum_untimed_priming_ms": {
          "type": "integer",
          "minimum": 1
        },
        "statistic": {
          "enum": [
            "best",
            "median"
          ]
        },
        "repetitions": {
          "type": "integer",
          "minimum": 1
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "providers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "version"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": [
              "string",
              "null"
            ]
          },
          "commit": {
            "type": [
              "string",
              "null"
            ]
          },
          "path": {
            "type": [
              "string",
              "null"
            ]
          },
          "note": {
            "type": [
              "string",
              "null"
            ]
          },
          "tag": {
            "type": "string",
            "description": "The version tag the provider was pinned to, when it has one (a commit alone is not enough to say which release a build came from)."
          },
          "sha256": {
            "type": "string",
            "description": "sha256 of the linked artifact, when the provider is a built native library whose revision cannot be read from the binary."
          }
        }
      }
    },
    "guards": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "idle_window_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "max_busy_percent": {
          "type": "number",
          "minimum": 0
        },
        "attempts": {
          "type": "integer",
          "minimum": 1
        },
        "logs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "outputs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "the harness timing stdout kept per run, whose priming banner the recorder reads"
        },
        "notes": {
          "type": "string",
          "description": "what the guard covered beyond the declared CPU set"
        }
      }
    },
    "invalidated_by": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "result_files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "run_spec": {
      "description": "What this particular run covered. A subset of the suite declaration is a valid run: the campaign is not run in full on every profile.",
      "type": "object",
      "required": [
        "sizes_mib",
        "dtypes",
        "engines",
        "aa"
      ],
      "additionalProperties": false,
      "properties": {
        "sizes_mib": {
          "type": "array",
          "items": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "minItems": 0,
          "description": "The nominal sizes this run covered, empty when the suite declares fixed shapes."
        },
        "dtypes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "engines": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "aa": {
          "type": "integer",
          "minimum": 1
        },
        "covers_declared_suite": {
          "type": "boolean"
        },
        "fixed_shapes": {
          "type": "boolean",
          "description": "The suite's corpus has fixed shapes; the runner was given no --size."
        }
      }
    },
    "suite_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$",
      "description": "Hash of the suite declaration in force when the run was taken. Evidence is immutable and declarations are not: without this, a manifest and a later declaration can disagree with no way to tell which moved."
    },
    "build_jobs": {
      "type": "integer",
      "minimum": 1,
      "description": "Cargo jobs the harness was built with. Not a measurement condition: it is recorded so a rebuild can be made with the same build parallelism, and it is independent of the threads the run measured at."
    }
  }
}
