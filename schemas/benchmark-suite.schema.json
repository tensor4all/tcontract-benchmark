{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tensor4all.example/schemas/benchmark-suite.schema.json",
  "title": "Benchmark Suite Declaration",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "description",
    "invalidated_by",
    "stale_after",
    "required_profiles",
    "runs",
    "corpus",
    "engines_doc"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9/_.-]*$"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "invalidated_by": {
      "description": "Paths in the measured repository whose commits make an existing result out of date.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "stale_after": {
      "description": "Number of invalidating commits between the measured revision and pins/tcontract-rs.rev at which the cell becomes stale.",
      "type": "integer",
      "minimum": 1
    },
    "required_profiles": {
      "description": "Profiles that must have a current cell; a missing one fails CI.",
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "optional_profiles": {
      "description": "Profiles reported when present and shown as missing otherwise, without failing CI.",
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "runs": {
      "description": "The measurements this suite declares.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "threads",
          "cpu_sets",
          "dtypes",
          "engines"
        ],
        "additionalProperties": false,
        "properties": {
          "threads": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1
            }
          },
          "cpu_sets": {
            "description": "One line for each thread count, in the order of `threads`.",
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "sizes_mib": {
            "type": "array",
            "items": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "dtypes": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "engines": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "case_filter": {
            "type": [
              "string",
              "null"
            ]
          },
          "stress": {
            "type": [
              "string",
              "null"
            ]
          },
          "fixed_shapes": {
            "type": "boolean",
            "description": "The corpus has fixed shapes, so the nominal-size knob does not apply and the runner is given no --size. `sizes_mib` must then be absent."
          }
        }
      }
    },
    "corpus": {
      "description": "What the workload is, in a form the result page can print.",
      "type": "object",
      "required": [
        "name",
        "description",
        "source"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "known_blind_spots": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "engines_doc": {
      "description": "One entry per engine the suite may declare, so a result page can explain every column it prints without the reader having any context.",
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": [
          "summary",
          "identity",
          "provider"
        ],
        "additionalProperties": false,
        "properties": {
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "identity": {
            "type": "string",
            "minLength": 1
          },
          "caveat": {
            "type": "string",
            "minLength": 1
          },
          "provider": {
            "description": "Name of the entry in run.yaml's `providers` that states the revision this engine actually ran against.",
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "description": "How a result page names this column, when the machine-readable engine id is not what a reader should see (for example `tprims [plan]` for `plan`). Defaults to the engine id."
          }
        }
      }
    },
    "runner": {
      "type": "string",
      "description": "The harness binary in the measured checkout that this suite runs, built and invoked from the same checkout as the library. Defaults to `tcbench`."
    },
    "features": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "The cargo features of the measured checkout's harness this suite needs, for example `upstream` for the tensorprimitives baseline or `tblis` for the TBLIS one. The recorder builds with these and the manifest records them."
    }
  }
}
